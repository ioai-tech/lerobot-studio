# Canonical site URL (SEO / absolute links). Production: https://lerobot.studio
SITE_URL=http://localhost:5173

# Vite base path for subdirectory deploys (default /)
# BASE_PATH=/

# Optional: remote sample datasets manifest. When unset, the welcome page hides
# the samples list. Sample archives are NOT shipped in this repository.
# Relative archive/cover paths resolve against the manifest directory (or
# optional manifest.baseUrl).
# VITE_SAMPLE_DATASETS_MANIFEST_URL=https://examples.example.com/samples/sample-datasets.manifest.json
